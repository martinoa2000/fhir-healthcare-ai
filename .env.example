# Copy to .env and edit. Every value below is the built-in default, so an empty
# .env (or no .env at all) gives you a working stack.
#
#   cp .env.example .env
#
# .env is git-ignored. Never commit real API keys or FHIR auth tokens.

# =============================================================================
# FHIR server connection
# =============================================================================
# Base URL of the FHIR R4 endpoint. Inside docker compose this is
# http://fhir:8080/fhir; on the host it is the published port below.
FHIR_BASE_URL=http://localhost:8080/fhir

FHIR_TIMEOUT_SECONDS=30.0
FHIR_MAX_RETRIES=2

# Bearer token for protected servers. Leave blank for the local HAPI container.
FHIR_AUTH_TOKEN=

# =============================================================================
# FHIR safety envelope
# =============================================================================
# Hard bounds enforced by the query validator. A generated query that exceeds
# any of these is rejected before it ever reaches the server, which is what
# keeps an LLM from planning an unbounded crawl of the record system.
FHIR_MAX_PAGE_SIZE=200
FHIR_MAX_PAGES=10
FHIR_MAX_TOTAL_RESOURCES=2000

# Serve a generated synthetic population from memory instead of FHIR_BASE_URL.
# Demo/CI only (`make demo`); the data is regenerated on every start.
FHIR_IN_MEMORY=false
FHIR_IN_MEMORY_PATIENTS=120
FHIR_IN_MEMORY_SEED=42

# Must stay false for the application: the query path is read-only by design.
# Only the seeder (fhir-ai-seed --push) sets this to true, and only against a
# disposable local server.
FHIR_ALLOW_WRITE=false

# =============================================================================
# LLM query planner
# =============================================================================
# vllm | huggingface | mock | openai | anthropic
#
# `vllm` (default) talks to a local OpenAI-compatible server -- the `vllm` compose
# profile, or anything else at LLM_BASE_URL. If that server is not reachable at startup
# the API falls back to `mock` and reports status "degraded" in /health, unless
# LLM_FALLBACK_TO_MOCK=false.
#
# `mock` is a deterministic, rule-based planner: the entire stack, the test suite and
# the benchmark run with NO model and NO API KEY. `openai` and `anthropic` send the
# question text to a hosted API; they need LLM_API_KEY and the matching extra
# (`pip install -e ".[openai]"` / `".[anthropic]"`).
LLM_PROVIDER=vllm

# For vllm this is the HuggingFace model id the server loads *and* serves; docker
# compose passes it to the vllm container too, so it must be a real Hub id there.
# For a hosted provider, set a model id of that provider instead.
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# Required only for LLM_PROVIDER=openai or anthropic.
LLM_API_KEY=

# OpenAI-compatible endpoint for LLM_PROVIDER=vllm. Blank means
# http://localhost:8001/v1 on the host (the published vllm port) and
# http://vllm:8000/v1 inside docker compose.
LLM_BASE_URL=

LLM_FALLBACK_TO_MOCK=true

# Planning must be reproducible, so temperature defaults to 0.
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=60.0
LLM_MAX_RETRIES=2

# =============================================================================
# Application
# =============================================================================
# local | dev | prod
ENVIRONMENT=local

LOG_LEVEL=INFO

# Structured JSON logs. Set to false for readable output while developing.
LOG_JSON=true

# Hard cap on how many patients a single natural-language request may surface.
MAX_PATIENTS_PER_RESPONSE=100

# Append-only JSONL audit trail of every plan, query and result count.
# Leave blank to disable file-based auditing (events still go to the logger).
AUDIT_LOG_PATH=
